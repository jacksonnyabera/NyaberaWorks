# Production settings. Copy to deploy/.env on the server and fill in.
# deploy/.env holds secrets: it must never be committed to Git.

# Your domain, without https://   e.g. nyaberaworks.co.ke
DOMAIN=example.com

# Use only letters and digits (no symbols), so it is safe inside a connection string.
# Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# At least 32 random characters.  Generate one:  openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME

LEAD_RATE_LIMIT_PER_HOUR=5
LOG_LEVEL=INFO

# Email notifications to you when someone submits a form.
# Leave as console until you have mail provider details; no email is sent then.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
