# NyaberaWorks environment template (placeholders only - never put real secrets here).
#
# To use it: copy the [backend] lines into backend/.env (that file is ignored by Git).
# Frontend variables are added to this file in a later Phase 1 step.

# ===== [backend] Application =====
APP_ENV=development                 # development | staging | production
APP_DEBUG=false                     # must be false in production
SITE_URL=http://localhost:3000      # production: https://your-domain
ENABLE_API_DOCS=true                # must be false in production
# Production is same-origin (one domain), so leave this empty.
# In development the Next.js dev server proxies /api, so it can stay empty too.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL