# NyaberaWorks environment template (placeholders only - never put real secrets here).
#
# Backend: copy the [backend] lines into backend/.env (ignored by Git).
#   The script scripts/create-dev-database.ps1 creates backend/.env for you,
#   including a random database password and secret key.
# Frontend: copy the [frontend] lines into frontend/.env.local (ignored by Git).

# ===== [backend] Application =====
APP_ENV=development                 # development | staging | production
APP_DEBUG=false                     # must be false in production
SITE_URL=http://localhost:3000      # production: https://your-domain
ENABLE_API_DOCS=true                # must be false in production
# Production is same-origin (one domain), so leave this empty.
# In development the Next.js dev server proxies /api, so it can stay empty too.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ===== [backend] Database and secrets =====
# PostgreSQL connection string. The password is a placeholder.
DATABASE_URL=postgresql+psycopg://nyaberaworks:CHANGE_ME@127.0.0.1:5432/nyaberaworks
# At least 32 random characters. Used to hash visitor IP addresses (and to sign tokens later).
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Form spam limit: submissions allowed per visitor per hour.
LEAD_RATE_LIMIT_PER_HOUR=5

# ===== [backend] Sign-in sessions (defaults are sensible; change only if you need to) =====
ACCESS_TOKEN_MINUTES=15             # how long a sign-in token lives in the browser
REFRESH_TOKEN_DAYS=14               # how long a device stays signed in without activity
SESSION_MAX_DAYS=30                 # a sign-in always ends after this, even with activity
LOGIN_MAX_FAILURES=5                # wrong passwords before the account is locked
LOGIN_LOCKOUT_MINUTES=15            # how long the lock lasts

# ===== [frontend] copy these into frontend/.env.local (ignored by Git) =====
# Public site address. Used for canonical links, sitemap and social previews.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the dev server forwards /api/* requests (FastAPI). Production uses Caddy instead.
API_PROXY_TARGET=http://127.0.0.1:8000
